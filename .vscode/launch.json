{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🐍 Python: Lists CLI Demo",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/src/data_structures/lists.py",
      "args": ["demo"],
      "console": "integratedTerminal",
      "justMyCode": true,
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "⚙️ Python: Lists CLI (Prompt for Subcommand & Args)",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/src/data_structures/lists.py",
      "args": ["${input:listsCliArgs}"],
      "console": "integratedTerminal",
      "justMyCode": true,
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "📄 Python: Run/Debug Current File",
      "type": "python",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "🧪 Python: Debug Pytest (Current Test File)",
      "type": "python",
      "request": "launch",
      "module": "pytest",
      "args": [
        "${file}",
        "-v"
      ],
      "console": "integratedTerminal",
      "justMyCode": false,
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "📊 Python: Pytest Full Suite with 100% Coverage",
      "type": "python",
      "request": "launch",
      "module": "pytest",
      "args": [
        "--cov=data_structures.lists",
        "--cov-report=term-missing",
        "test/data_structures/test_lists.py"
      ],
      "console": "integratedTerminal",
      "justMyCode": false,
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}"
    }
  ],
  "inputs": [
    {
      "id": "listsCliArgs",
      "type": "promptString",
      "description": "Enter subcommand & arguments (e.g. 'sort --elements banana,apple,fig --key length' or 'stats --elements 10,20,30'):",
      "default": "sort --elements banana,apple,fig --key length"
    }
  ]
}
