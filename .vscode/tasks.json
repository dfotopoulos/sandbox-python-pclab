{
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}"
  },
  "tasks": [
    {
      "label": "🎓 Example List 001 (Interactive Input Prompt)",
      "type": "shell",
      "command": "Set-Location '${workspaceFolder}'; uv --directory '${workspaceFolder}' run src/tutorial/list/example_list_001/example_list_001.py ${input:exampleList001Args}",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "🎓 Example List 001 (Sort Nick, Filippos, Dimitra)",
      "type": "shell",
      "command": "Set-Location '${workspaceFolder}'; uv --directory '${workspaceFolder}' run src/tutorial/list/example_list_001/example_list_001.py --data Nick Filippos Dimitra --sort",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "🎓 Example List 001 (Sort Dimitrios, James, John)",
      "type": "shell",
      "command": "Set-Location '${workspaceFolder}'; uv --directory '${workspaceFolder}' run src/tutorial/list/example_list_001/example_list_001.py --data Dimitrios James John --sort",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "🎓 Example List 001 (Help)",
      "type": "shell",
      "command": "Set-Location '${workspaceFolder}'; uv --directory '${workspaceFolder}' run src/tutorial/list/example_list_001/example_list_001.py --help",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "🐍 Lists CLI (Interactive Subcommand Prompt)",
      "type": "shell",
      "command": "Set-Location '${workspaceFolder}'; uv --directory '${workspaceFolder}' run src/data_structures/lists.py ${input:listsCliArgs}",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "🐍 Lists CLI Demo (Showcase)",
      "type": "shell",
      "command": "Set-Location '${workspaceFolder}'; uv --directory '${workspaceFolder}' run src/data_structures/lists.py demo",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "🧪 Pytest: Test Example List 001",
      "type": "shell",
      "command": "Set-Location '${workspaceFolder}'; uv --directory '${workspaceFolder}' run pytest test/tutorial/list/example_list_001/test_example_list_001.py -v",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "🧪 Pytest: Test Lists Manager",
      "type": "shell",
      "command": "Set-Location '${workspaceFolder}'; uv --directory '${workspaceFolder}' run pytest test/data_structures/test_lists.py -v",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "📊 Pytest: Full Suite with 100% Coverage",
      "type": "shell",
      "command": "Set-Location '${workspaceFolder}'; uv --directory '${workspaceFolder}' run pytest --cov=src --cov-report=term-missing test/",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "📦 UV: Sync Dependencies (.venv)",
      "type": "shell",
      "command": "Set-Location '${workspaceFolder}'; uv --directory '${workspaceFolder}' sync --python python",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "✨ Format Code & Docs (Prettier)",
      "type": "shell",
      "command": "Set-Location '${workspaceFolder}'; pnpm run format",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "🔍 Lint Code (Ruff)",
      "type": "shell",
      "command": "Set-Location '${workspaceFolder}'; uv --directory '${workspaceFolder}' run ruff check src/ test/",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "🛡️ Static Type Check (Mypy)",
      "type": "shell",
      "command": "Set-Location '${workspaceFolder}'; uv --directory '${workspaceFolder}' run mypy src/",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "exampleList001Args",
      "type": "promptString",
      "description": "Enter CLI flags for example_list_001 (e.g. '--data Nick Filippos Dimitra --sort'):",
      "default": "--data Nick Filippos Dimitra --sort"
    },
    {
      "id": "listsCliArgs",
      "type": "promptString",
      "description": "Enter subcommand & arguments for lists.py (e.g. 'stats --elements 10,20,30,40' or 'demo'):",
      "default": "stats --elements 10,20,30,40,50"
    }
  ]
}
